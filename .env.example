# Browser-safe Supabase configuration. Publishable keys are public identifiers, not service-role secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_CORNERMEX_CHECKOUT_ENABLED=false

# Server-only configuration. Never prefix service-role or integration secrets with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=

# Isolated CornerMex MCP Edge Function configuration.
# These are inert until the Edge Function is separately deployed and OAuth is enabled.
# The MCP function uses the publishable key plus the caller's OAuth JWT. Never add service_role here.
MCP_PUBLIC_URL=
MCP_ALLOWED_HOSTNAMES=
MCP_ALLOWED_ORIGIN_HOSTNAMES=

CORNERMEX_COMMERCE_MODEL=single_merchant_with_internal_supplier_network
CORNERMEX_APPLICATION_ENV=development
CORNERMEX_PUBLIC_APPLICATION_URL=
CORNERMEX_MARKETPLACE_ENABLED=false
CORNERMEX_SELLER_AUTH_ENABLED=false
CORNERMEX_SELLER_PAYOUTS_ENABLED=false
CORNERMEX_COMMISSIONS_ENABLED=false
CORNERMEX_CHECKOUT_ENABLED=false
CORNERMEX_EXTERNAL_EMAIL_ENABLED=false
CORNERMEX_EXTERNAL_MESSAGES_ENABLED=false
CORNERMEX_REAL_PAYMENT_EXECUTION_ENABLED=false

# CM-INT-ZOHO-1 remains fail-closed. All values are server-only; never expose
# them through a VITE_ variable. Product, organization, data center and UAE VAT
# mapping require evidence plus a separate activation authorization.
CORNERMEX_ZOHO_LIVE_WRITES_ENABLED=false
CORNERMEX_ZOHO_PRODUCT=
CORNERMEX_ZOHO_ORGANIZATION_ID=
CORNERMEX_ZOHO_API_BASE_URL=
CORNERMEX_ZOHO_ACCESS_TOKEN=
CORNERMEX_ZOHO_VAT_TAX_ID=
CORNERMEX_INTEGRATION_WORKER_SECRET=
CORNERMEX_AUTOMATIC_IMPORT_ENABLED=false
CORNERMEX_AUTOMATIC_INVENTORY_SYNC_ENABLED=false
CORNERMEX_OPENCLAW_ENABLED=false
CORNERMEX_CORNEROPS_WRITE_ENABLED=false

# PO intake transport only; provider execution has an independent hard stop in code.
# Never use a production organization as a test organization.
CORNERMEX_PO_INTAKE_ENABLED=false
CORNERMEX_PO_INTAKE_SECRET=
CORNERMEX_PO_MODE=test
CORNERMEX_PO_ORGANIZATION_ID=

# ── CornerMex MX ────────────────────────────────────────────────────────────
# docs/cornermex-mx/MARKET-CONFIG.md. Every value below is a name only: real
# values belong in the deployment's secret store, never in this file.
#
# The Mexico deployment must declare its market and its own Supabase project.
# The application refuses to start against a UAE project.
CORNERMEX_MARKET=MX
CORNERMEX_MX_SUPABASE_PROJECT_REF=
CORNERMEX_PUBLIC_APPLICATION_URL=
CORNERMEX_QUOTE_SIGNING_SECRET=
CORNERMEX_MX_ORIGIN_JSON=
CORNERMEX_MX_MANUAL_SHIPPING_JSON=
CORNERMEX_MX_SHIPPING_RANKING=BEST_VALUE
CORNERMEX_MX_LEGAL_DOCS_PUBLISHED=false
# Cash on delivery: off by default, local delivery only when on.
CORNERMEX_MX_COD_LOCAL_ENABLED=false
# Shipping providers (sandbox unless ENVIRONMENT=production).
SKYDROPX_ENABLED=false
SKYDROPX_ENVIRONMENT=sandbox
SKYDROPX_CLIENT_ID=
SKYDROPX_CLIENT_SECRET=
SOLO_ENVIOS_ENABLED=false
SOLO_ENVIOS_ENVIRONMENT=sandbox
SOLO_ENVIOS_CLIENT_ID=
SOLO_ENVIOS_CLIENT_SECRET=
# Payment providers. The Access Token and secrets are server-side only.
MERCADO_PAGO_ENABLED=false
MERCADO_PAGO_ENVIRONMENT=sandbox
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
CLIP_ENABLED=false
CLIP_ENVIRONMENT=
CLIP_API_KEY=
CLIP_API_SECRET=
CLIP_WEBHOOK_SECRET=
MERCADO_PAGO_PUBLIC_KEY=
CORNERMEX_REAL_SHIPPING_PURCHASE_ENABLED=false
